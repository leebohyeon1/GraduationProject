  DialogueList:
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC88B\uC544 \uBC1B\uC544\uB4E4\uC600\uAD6C\uB098."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC774 \uC232\uC744 \uACC4\uC18D \uB098\uC544\uAC00\uB2E4 \uBCF4\uBA74
      \uB108\uB97C \uACF5\uACA9\uD588\uB358 \uADF8 \uB098\uB974\uB97C \uB9CC\uB0A0
      \uC218 \uC788\uC744\uAC70\uC57C."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uADF8 \uB140\uC11D\uC774 \uC544\uB9C8 \uC6D0\uD749\uC778 \uAC83
      \uAC19\uC73C\uB2C8, \uADF8 \uB140\uC11D\uC744 \uCC3E\uC544 \uCC98\uCE58\uD558\uBA74
      \uB3FC."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC544.. \uADF8\uB9AC\uACE0 \uB9D0\uC774\uC57C.."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC808\uB300 \uACC4\uC57D\uC744 \uC5B4\uAE38 \uC0DD\uAC01 \uD558\uC9C0\uB9C8.
      \uC808\uB300\uB85C."
    Sound: {fileID: 0}
