  NeedConditionList: []
  DialogueList:
  - SpeakerName: 
    DialogueText: "\uC218\uB9CE\uC740 \uB098\uB974\uB97C \uCC98\uCE58\uD558\uBA70
      \uB098\uC544\uAC00\uB358 \uC694\uB974\uBB38\uC740 \uAC70\uB300\uD55C \uC7A5\uC560\uBB3C\uB85C
      \uB9C9\uD78C \uB9C9\uB2E4\uB978 \uAE38\uC5D0 \uB2E4\uB2E4\uB790\uB2E4."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uC7A5\uC560\uBB3C \uC55E\uC5D0\uB294 \uC54C \uC218 \uC5C6\uB294
      \uD1A0\uD15C\uB4E4\uC774 \uD37C\uC990\uCC98\uB7FC \uB193\uC5EC \uC788\uC5C8\uACE0,
      \uC774 \uAC83\uC744 \uBCF8 \uC694\uB974\uBB38\uC740 \uC774\uB0B4 \uAE68\uB2EC\uC744
      \uC218 \uC788\uC5C8\uB2E4."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uC774 \uD37C\uC990\uC744 \uD480\uC5B4\uC57C\uB9CC \uC232 \uB354\uC6B1
      \uAE4A\uC740 \uACF3\uC73C\uB85C \uD5A5\uD560 \uC218 \uC788\uC74C\uC744."
    Sound: {fileID: 0}
