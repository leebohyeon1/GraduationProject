  m_Script: {fileID: 11500000, guid: 0619fb8750ed77c44a41a2e203ef5c61, type: 3}
  m_Name: New DialogueDataSO 35
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDataSO
  DialogueGroupID: 0
  DialogueType: 0
  NeedConditionList: []
  DialogueList:
  - SpeakerName: 
    DialogueText: "\uC0AC\uB77C\uC9C4 \uD504\uB808\uC774\uC57C\uB97C \uB4A4\uB85C\uD55C
      \uCCB4 \uC694\uB974\uBB38\uC740 \uACF0\uACF0\uD788 \uC0DD\uAC01\uC5D0 \uBE60\uC84C\uB2E4."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uC790\uC2E0\uC758 \uC5FC\uC6D0\uC758 \uC870\uAC01\uC740 \uC774
      \uC138\uACC4\uC5D0 \uC5BC\uB9C8\uB098 \uD37C\uC838 \uC788\uB294 \uAC78\uAE4C."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uB2E4\uB978 \uC9C0\uC5ED\uB3C4 \uC774 \uACF3\uACFC \uBE44\uC2B7\uD55C
      \uC0C1\uD669\uC77C\uAE4C"
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uADF8\uB7EC\uD55C \uC0DD\uAC01\uC744 \uD55C \uC694\uB974\uBB38\uC740
      \uB354 \uC774\uC0C1 \uACE0\uBBFC\uD558\uC9C0 \uC54A\uACE0, \uC6C0\uC9C1\uC774\uAE30
      \uC2DC\uC791\uD588\uB2E4."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uC774 \uC138\uACC4\uC5D0 \uD37C\uC838\uC788\uB294 \uC790\uC2E0\uC758
      \uC5FC\uC6D0\uC758 \uC870\uAC01\uC744 \uC218\uAC70\uD558\uAE30 \uC704\uD574."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uADF8\uB9AC\uACE0 \uC790\uC2E0\uC774 \uD37C\uB728\uB9B0 \uC7AC\uC559\uC758
      \uC528\uC557\uC744 \uAC70\uB450\uC5B4 \uAC00\uAE30 \uC704\uD574."
    Sound: {fileID: 0}
