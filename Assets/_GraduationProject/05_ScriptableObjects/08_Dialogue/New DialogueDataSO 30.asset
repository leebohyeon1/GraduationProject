  NeedConditionList: []
  DialogueList:
  - SpeakerName: 
    DialogueText: "\uC218\uB9CE\uC740 \uB098\uB974\uB4E4\uC744 \uCC98\uCE58\uD574
      \uB098\uC544\uAC00\uB358 \uC694\uB974\uBB38\uC740 \uB9C8\uCE68\uB0B4 \uC232\uC758
      \uC2EC\uCE35\uBD80\uC5D0 \uB3C4\uCC29\uD588\uB2E4."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uC694\uB974\uBB38\uC740 \uBCF8\uB2A5\uC801\uC73C\uB85C \uC774
      \uB108\uBA38\uC5D0 \uC232\uC744 \uAC10\uC5FC\uC2DC\uD0A8 \uC6D0\uD749\uC774
      \uC788\uB2E4\uB294 \uAC83\uC744 \uB290\uB084 \uC218 \uC788\uC5C8\uB2E4"
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uC694\uB974\uBB38\uC740 \uC790\uC2E0\uC758 \uC18D\uC8C4\uB97C
      \uC774\uB8E8\uAE30 \uC704\uD574. \uC232\uC744 \uB418\uB3CC\uB9AC\uAE30 \uC704\uD574."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uC694\uB974\uBB38\uC740 \uB098\uB974\uAC00 \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uB294 \uADF8 \uACF3\uC744 \uD5A5\uD574 \uB098\uC544\uAC14\uB2E4."
    Sound: {fileID: 0}
