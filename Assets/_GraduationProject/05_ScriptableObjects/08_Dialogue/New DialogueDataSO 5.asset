  DialogueList:
  - SpeakerName: 
    DialogueText: "\uC0AC\uBC29\uC774 \uB9C9\uD78C \uD3D0\uC1C4\uB41C \uAD6C\uC5ED.
      \uADF8 \uC815\uC801 \uC18D\uC5D0\uC11C \uC218\uB9CE\uC740 \uB098\uB974\uAC00
      \uC694\uB974\uBB38\uC744 \uC5D0\uC6CC\uC30C\uB2E4."
    Sound: {fileID: 8300000, guid: 929ee1a315eff194e8026973c83dc831, type: 3}
  - SpeakerName: 
    DialogueText: "\uC9C0\uAE08 \uC774 \uC21C\uAC04 \uC694\uB974\uBB38\uC774 \uAE68\uB2EC\uC740
      \uAC83\uC740 \uB2E8 \uD558\uB098. "
    Sound: {fileID: 8300000, guid: 54ac7b2ee7e1f1749840bc2d2617b5ca, type: 3}
  - SpeakerName: 
    DialogueText: " \uBAA8\uB4E0 \uB098\uB974\uB97C \uCC98\uCE58\uD558\uACE0, \uC774
      \uC9C0\uC625 \uAC19\uC740 \uACF3\uC5D0\uC11C \uBC18\uB4DC\uC2DC \uC0B4\uC544\uB0A8\uC544\uC57C
      \uD55C\uB2E4\uB294 \uC0AC\uC2E4\uBFD0\uC774\uC5C8\uB2E4."
    Sound: {fileID: 8300000, guid: bb1b15a3e37985f4b9d3f5e46144e624, type: 3}
