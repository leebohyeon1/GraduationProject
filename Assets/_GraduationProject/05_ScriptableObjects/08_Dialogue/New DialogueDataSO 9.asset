  - {fileID: 11400000, guid: dfa85bbaee0eb844c8c3a4d905341322, type: 2}
  DialogueList:
  - SpeakerName: 
    DialogueText: "\uC232\uC744 \uBC97\uC5B4\uB09C \uC694\uB974\uBB38\uC758 \uB208\uC55E\uC5D0,
      \uB113\uC740 \uAC15 \uC911\uC559\uC5D0 \uD640\uB85C \uB5A0 \uC788\uB294 \uC678\uB85C\uC6B4
      \uC12C \uD558\uB098\uAC00 \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0C8\uB2E4. "
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uC0AC\uBC29\uC774 \uBB3C\uB85C \uAC00\uB85C\uB9C9\uD78C \uADF8\uACF3\uC5D0\uC11C\uB294
      \uAE30\uBB18\uD55C \uAE30\uC6B4\uC774 \uBFDC\uC5B4\uC838 \uB098\uC624\uACE0
      \uC788\uC5C8\uB2E4. "
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uC694\uB974\uBB38\uC740 \uADF8 \uC774\uC9C8\uC801\uC778 \uAE30\uC6B4\uC5D0
      \uBCF8\uB2A5\uC801\uC73C\uB85C \uC774\uB04C\uB838\uACE0, \uB9DD\uC124\uC784
      \uC5C6\uC774 \uADF8 \uB0AF\uC120 \uACF5\uAC04\uC744 \uD5A5\uD574 \uCCAB \uBC1C\uC744
      \uB0B4\uB514\uB3A0\uB2E4."
    Sound: {fileID: 0}
