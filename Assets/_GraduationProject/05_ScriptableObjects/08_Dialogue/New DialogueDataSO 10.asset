  DialogueList:
  - SpeakerName: 
    DialogueText: "\uADF8\uB9AC\uACE0 \uC694\uB974\uBB38\uC744 \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uC5C8\uB358 \uAC83\uC740 \uC54C \uC218 \uC5C6\uB294 \uAE30\uC6B4\uC744
      \uBFDC\uC5B4\uB0B4\uB294 \uC870\uAC01\uC774\uC5C8\uB2E4."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uC774 \uC870\uAC01\uC774 \uBB34\uC5C7\uC778\uC9C0 \uC694\uB974\uBB38\uC740
      \uC54C \uC218 \uC5C6\uC5C8\uC9C0\uB9CC, \uBCF8\uB2A5\uC801\uC73C\uB85C\uB294
      \uB290\uB084 \uC218 \uC788\uC5C8\uB2E4. "
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uC774 \uC870\uAC01\uC774 \uADF8 \uB204\uAD6C\uB3C4 \uC544\uB2CC
      \uC694\uB974\uBB38 \uC790\uAE30 \uC790\uC2E0\uC744 \uBD80\uB974\uACE0 \uC788\uC5C8\uB2E4\uB294
      \uAC83\uC744."
    Sound: {fileID: 0}
