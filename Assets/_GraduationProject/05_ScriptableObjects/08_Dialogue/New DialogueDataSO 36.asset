  NeedConditionList: []
  DialogueList:
  - SpeakerName: 
    DialogueText: "\uADF8\uB807\uB2E4\uBA74 \uC694\uB974\uBB38\uC740 \uC5B4\uB514\uB85C
      \uD5A5\uD558\uB294 \uAC78\uAE4C. "
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "'\uBC40\uC774 \uAE43\uB4E0 \uBC14\uC704' '\uACF0\uC774 \uC228\uC740
      \uB3D9\uAD74' '\uC0B0\uC591\uC774 \uC19F\uC740 \uACE0\uC6D0'"
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "'\uBC40\uC774 \uAE43\uB4E0 \uBC14\uC704'"
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "'\uACF0\uC774 \uC228\uC740 \uB3D9\uAD74'"
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "'\uC0B0\uC591\uC774 \uC19F\uC740 \uACE0\uC6D0'"
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uC5B4\uB514\uB85C \uAC08\uC9C0\uB294 \uADF8 \uBB34\uC5C7\uB3C4
      \uD655\uC2E0\uD560 \uC218 \uC5C6\uC5C8\uB2E4."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uB2E8 \uADF8\uAC83 \uD558\uB098 \uB9CC\uD07C\uC740 \uD655\uC2E4\uD588\uB2E4."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uC694\uB974\uBB38\uC740 \uC5B8\uC820\uAC00 \uC790\uC2E0\uC758
      \uC5FC\uC6D0\uC758 \uC870\uAC01 \uC804\uBD80\uB97C \uD68C\uC218\uD558\uACE0
      \uC790\uC2E0\uC774 \uBFCC\uB9B0 \uBAA8\uB4E0 \uC528\uC557\uC744 \uAC70\uB450\uC5B4
      \uAC04\uB2E4\uB294 \uAC83 \uB9D0\uC774\uB2E4.\r\n"
    Sound: {fileID: 0}
