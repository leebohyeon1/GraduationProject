  DialogueList:
  - SpeakerName: 
    DialogueText: "\uC694\uB974\uBB38\uC774 \uD1A0\uD15C\uC744 \uAC74\uB4DC\uB9AC\uB294
      \uC21C\uAC04, \uADF8 \uC548\uC5D0 \uC7A0\uB4E4\uC5B4 \uC788\uB358 \uAE30\uC6B4\uC774
      \uC694\uB974\uBB38\uC758 \uBAB8\uC5D0 \uC2A4\uBA70\uB4E4\uC5C8\uB2E4."
    Sound: {fileID: 8300000, guid: cee96c998a9c9d94d8a32bdecebba212, type: 3}
  - SpeakerName: 
    DialogueText: "\uC694\uB974\uBB38\uC740 \uBBF8\uC57D\uD558\uAC8C\uB098\uB9C8
      \uC790\uC2E0\uC758 \uD798 \uC911 \uADF9\uD788 \uC77C\uBD80\uAC00 \uB418\uB3CC\uC544\uC624\uB294
      \uAC83\uC744 \uB290\uAF08\uB2E4."
    Sound: {fileID: 8300000, guid: f68733b043b27fe41aa9a0a83a509c74, type: 3}
  - SpeakerName: 
    DialogueText: "\uADF8\uAC83\uC740 \uAE34 \uC5EC\uC815\uC758 \uC2DC\uC791\uC774\uC790,
      \uB2E4\uC2DC \uC790\uC2E0\uC758 \uD798\uC744 \uB418\uCC3E\uAE30 \uC704\uD55C
      \uCCAB\uAC78\uC74C\uC774\uC5C8\uB2E4."
    Sound: {fileID: 8300000, guid: 912b8512ee56ea84eb7b497fc7c7fd32, type: 3}
