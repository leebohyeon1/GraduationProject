%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0619fb8750ed77c44a41a2e203ef5c61, type: 3}
  m_Name: New DialogueDataSO 12
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDataSO
  DialogueGroupID: 11
  DialogueType: 1
  NeedConditionList:
  - {fileID: 11400000, guid: 573b67296177ade40824bf86bcb84544, type: 2}
  DialogueList:
  - SpeakerName: ???
    DialogueText: "\uC774 \uAE4A\uC740 \uC131\uC18C\uC758 \uCE68\uBB35\uC744 \uAE68\uB728\uB9B0
      \uBC1C\uC18C\uB9AC\uAC00 \uB204\uAD6C\uC758 \uAC83\uC778\uAC00 \uD588\uB354\uB2C8...
      \uAC00\uB828\uD55C \uB9AC\uD504 \uD558\uB098\uAC00 \uC228\uC5B4 \uB4E4\uC5B4\uC654\uAD6C\uB098."
    Sound: {fileID: 0}
  - SpeakerName: ???
    DialogueText: "\uBC18\uAC11\uAD6C\uB098, \uB9AC\uD504\uC5EC."
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uB098\uB294 \uC138\uACC4\uC758 \uBAA8\uB4E0 \uC9C0\uC2DD\uC744
      \uBCF4\uAD00\uD558\uACE0 \uC774\uC57C\uAE30\uB97C \uC804\uD574\uC8FC\uB294
      \uC874\uC7AC, \uC9C0\uC2DD\uC758 \uC2E0 '\uD06C\uB9AC\uADF8'\uB77C\uACE0 \uD558\uB124."
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uADF8\uB7F0\uB370 \uAC00\uB828\uD55C \uB9AC\uD504\uC5EC, \uC5B4\uB5BB\uAC8C
      \uD558\uC5EC \uC774 \uC870\uAC01\uC744 \uB124\uAC00 \uD761\uC218\uD560 \uC218
      \uC788\uC5C8\uB358 \uAC70\uC9C0?"
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uC774 \uC870\uAC01\uC740 \uB108 \uAC19\uC774 \uC5F0\uC57D\uD55C
      \uC874\uC7AC\uAC00 \uB2E4\uB8F0 \uC218 \uC788\uB294 \uAC83\uC774 \uC544\uB2CC\uB370
      \uB9D0\uC774\uC9C0..."
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: ...
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uC544... \uC124\uB9C8..."
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uB124\uAC00 \uBC14\uB85C \uACFC\uAC70 \uADF8 \uC8C4\uC545\uC744
      \uC800\uC9C8\uB800\uB2E4 \uC7A0\uB4E4\uC5C8\uB358 \uC874\uC7AC, \uC694\uB974\uBB38\uC774\uAD6C\uB098"
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uC774\uBD10, \uC694\uB974\uBB38. \uC790\uB124 \uD639\uC2DC \uADF8\uB7F0
      \uC5F0\uC57D\uD55C \uC874\uC7AC\uB85C \uB2E4\uC2DC \uD0DC\uC5B4\uB09C \uAC74\uAC00?
      \uADF8 \uC6A9\uC758 \uC2E0 \uC694\uB974\uBB38\uC774?"
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uD5C8.. \uADF8 \uB208\uBE5B\uC740 \uBB50\uC9C0... \uC124\uB9C8
      \uC8C4\uCC45\uAC10\uC774\uB77C\uB3C4 \uAC00\uC9C0\uACE0 \uC788\uB294 \uAC74\uAC00?"
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uD558! \uC6C3\uAE30\uB294\uAD70! \uCC9C\uD558\uC758 \uC694\uB974\uBB38\uC774
      \uC8C4\uCC45\uAC10\uC744 \uAC00\uC9C0\uACE0 \uC788\uB2E4\uACE0? \uADF8 \uC694\uB974\uBB38\uC774??"
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uC815\uB9D0 \uB9D0\uB3C4 \uC548\uB418\uB294\uAD70.. \uC774 \uBAA8\uB4E0\uAC83\uC744
      \uC800\uC9C8\uB7EC \uB193\uACE0 \uC774\uC81C \uC640\uC11C \uC8C4\uCC45..."
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: ...
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uD558, \uC6C3\uC5B4\uC11C \uBBF8\uC548\uD558\uAD70. \uB9AC\uD504\uC640
      \uC774\uC57C\uAE30\uD574\uBCF4\uB294 \uAC83\uB3C4 \uB108\uBB34 \uC624\uB79C\uB9CC\uC774\uB77C
      \uC880 \uC2E0\uB0AC\uC5C8\uB098 \uBCF4\uAD70.. \uC0AC\uACFC\uB97C \uC804\uD558\uC9C0."
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uC774\uBD10 \uC694\uB974\uBB38, \uB098\uC640 \uACC4\uC57D \uD558\uB098
      \uD558\uC9C0 \uC54A\uACA0\uB294\uAC00?"
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uB09C \uB124\uAC00 \uC6D0\uD558\uB294 \uAC83\uC774 \uBB34\uC5C7\uC778\uC9C0,
      \uB124\uAC00 \uC5B4\uB514\uB85C \uAC00\uC57C \uD560\uC9C0 \uC54C\uACE0 \uC788\uC5B4."
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uADF8\uB7EC\uB2C8 \uB0B4\uAC00 \uB110 \uB3C4\uC640\uC8FC\uACA0\uB124. "
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uB2E8, \uC870\uAC74\uC774 \uC788\uB2E4\uB124."
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uB124\uAC00 \uD589\uD558\uACE0\uC790 \uD558\uB294 \uADF8 \uC18D\uC8C4\uAC00
      \uB05D\uB09C \uB4A4 \uB098\uC5D0\uAC8C \uCC3E\uC544\uC640, \uB124\uAC00 \uACAA\uC740
      \uBAA8\uB4E0 \uC774\uC57C\uAE30\uB97C \uD558\uB098\uB3C4 \uBE60\uC9D0\uC5C6\uC774
      \uB098\uC5D0\uAC8C \uB4E4\uB824\uC8FC\uAC8C. "
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uADF8\uAC8C \uACC4\uC57D \uC870\uAC74\uC774\uB124. \uC5B4\uB5BB\uAC8C...
      \uBC1B\uC544\uB4E4\uC774\uACA0\uB098?"
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uBC1B\uC544\uB4E4\uC774\uACA0\uB2E4\uBA74 \uADF8 \uD798\uC744
      \uAC00\uC838\uAC00\uB3C4 \uC88B\uB124."
    Sound: {fileID: 0}
  ClearAddTagList:
  - {fileID: 11400000, guid: d980d4fe81c471545aac63c5df1a47ce, type: 2}
