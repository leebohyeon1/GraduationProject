  m_Script: {fileID: 11500000, guid: 0619fb8750ed77c44a41a2e203ef5c61, type: 3}
  m_Name: New DialogueDataSO 19
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDataSO
  DialogueGroupID: 0
  DialogueType: 0
  NeedConditionList: []
  DialogueList:
  - SpeakerName: 
    DialogueText: "\uACFC\uAC70 \uC601\uD63C\uB4E4\uC774 \uD65C\uBC1C\uD558\uAC8C
      \uC9C0\uB0B4\uB358 \uC232\uC740 \uC774\uBBF8 \uC218\uB9CE\uC740 \uB098\uB974\uC5D0
      \uC758\uD574 \uCC98\uCC38\uD558\uAC8C \uAC10\uC5FC\uB418\uC5B4 \uC788\uC5C8\uB2E4."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uADF8 \uAD11\uACBD\uC744 \uBAA9\uACA9\uD55C \uC694\uB974\uBB38\uC5D0\uAC8C
      \uC790\uC2E0\uC758 \uD589\uB3D9\uC5D0 \uB300\uD55C \uD6C4\uD68C\uC640 \uC8C4\uCC45\uAC10\uC774
      \uBAB0\uB824\uC654\uB2E4. "
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uD558\uC9C0\uB9CC \uC9C0\uAE08 \uD560 \uC218 \uC788\uB294 \uAC83\uC740
      \uC88C\uC808\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: " \uC694\uB974\uBB38\uC740 \uC5FC\uC6D0\uC758 \uC870\uAC01\uC744
      \uB418\uCC3E\uC544 \uB354\uB7FD\uD600\uC9C4 \uC138\uACC4\uB97C \uB2E4\uC2DC
      \uCC2C\uB780\uD788 \uBE5B\uB098\uAC8C \uD558\uB9AC\uB77C \uB9C8\uC74C\uC744
      \uBA39\uC73C\uBA70 \uAC10\uC5FC\uB41C \uC232\uC73C\uB85C \uBC1C\uC744 \uB0B4\uB514\uB3A0\uB2E4."
    Sound: {fileID: 0}
