--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0619fb8750ed77c44a41a2e203ef5c61, type: 3}
  m_Name: New DialogueDataSO 34
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDataSO
  DialogueGroupID: 0
  DialogueType: 1
  NeedConditionList: []
  DialogueList:
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uD5C8.. \uACB0\uAD6D \uD574\uB0C8\uAD6C\uB098. \uC694\uB974\uBB38."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC194\uC9C1\uD788.. \uB108\uAC00 \uD574\uB0BC \uC218 \uC788\uC744
      \uAC70\uB77C\uB294 \uC0DD\uAC01\uC740 \uD558\uC9C0 \uC54A\uC558\uC5B4."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uADF8\uB0E5.. \uB108\uC5D0 \uB300\uD55C \uC6D0\uB9DD\uC2EC \uB54C\uBB38\uC5D0
      \uD55C \uB9D0\uC774\uC5C8\uC9C0."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uADF8\uB7F0\uB370 \uB108\uB294 \uACB0\uAD6D \uBCF4\uB780\uB4EF\uC774
      \uD574\uB0C8\uAD6C\uB098.."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uADF8 \uB140\uC11D\uC744 \uCC98\uCE58\uD558\uACE0 \uC232\uC744
      \uB418\uB3CC\uB9AC\uB294\uB370 \uD070 \uAE30\uC5EC\uB97C \uD588\uC5B4."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: ...
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC774\uBD10 \uC694\uB974\uBB38.. \uC0AC\uACFC\uB294 \uD558\uC9C0
      \uC54A\uC744\uAC8C."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uB108\uB294 \uC774 \uC232\uC744 \uB354\uB7FD\uD78C \uADFC\uBCF8\uC801\uC778
      \uC6D0\uD749\uC774\uACE0, \uB09C \uADF8\uAC78 \uD3C9\uC0DD \uC78A\uC9C0 \uC54A\uC744\uAC70\uC57C."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uD558\uC9C0\uB9CC \uB108\uAC00 \uC774 \uC232\uC744 \uAD6C\uD574\uC900
      \uAC83\uB3C4.. \uD3C9\uC0DD \uC78A\uC9C0 \uC54A\uC744\uD14C\uC9C0.."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC774\uBD10 \uC694\uB974\uBB38."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uACE0\uB9C8\uC6CC. \uC232\uC744 \uAD6C\uD574\uC918\uC11C.."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC6B0\uB9AC\uC758 \uACC4\uC57D\uC740 \uB05D\uC774\uC57C. \uB108\uAC00
      \uADF8 \uB140\uC11D\uC744 \uCC98\uCE58\uD588\uC73C\uB2C8, \uACC4\uC57D\uC740
      \uB05D\uB09C\uAC70\uC9C0."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uB098\uBA38\uC9C0 \uB098\uB974 \uC794\uB2F9\uB4E4\uC740 \uB0B4\uAC00
      \uCC98\uCE58\uD558\uB3C4\uB85D \uD560\uAC8C."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uADF8\uB7EC\uB2C8 \uB108\uB294 \uB5A0\uB098\uACE0 \uC2F6\uC73C\uBA74
      \uB9C8\uC74C\uB300\uB85C \uB5A0\uB098\uB3C4 \uC88B\uC544."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC694\uB974\uBB38.."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uACE0\uB9C8\uC6CC.."
    Sound: {fileID: 0}
