  DialogueList:
  - SpeakerName: 
    DialogueText: "\uD55C\uB54C \uC6A9\uC758 \uC2E0\uC73C\uB85C \uBD88\uB838\uB358
      \uC694\uB974\uBB38\uC740 \uAE4A\uC740 \uC7A0\uC5D0\uC11C \uAE68\uC5B4\uB098
      \uC57D\uD574\uC9C4 \uC721\uC2E0\uC744 \uC77C\uC73C\uCF1C \uC138\uC6B0\uBA70
      \uC815\uC2E0\uC744 \uCC28\uB838\uB2E4."
    Sound: {fileID: 8300000, guid: 1016f967bf68ffa458a5399ebaa09741, type: 3}
  - SpeakerName: 
    DialogueText: "\uACFC\uAC70\uC758 \uC601\uAD11\uACFC\uB294 \uB2EC\uB9AC, \uC694\uB974\uBB38\uC758
      \uC721\uC2E0\uC740 \uC5F0\uC57D\uD558\uACE0 \uC791\uC544\uC838 \uC788\uC5C8\uB2E4."
    Sound: {fileID: 8300000, guid: 04c7da82465f0e74099be223ac43a90e, type: 3}
  - SpeakerName: 
    DialogueText: "\uC694\uB974\uBB38\uC740 \uC57D\uD574\uC9C4 \uC721\uC2E0\uC744
      \uC5B5\uC9C0\uB85C \uC774\uB04C\uBA70, \uC2A4\uC2A4\uB85C \uC9CA\uC5B4\uC9C4
      \uACFC\uAC70\uC758 \uC18D\uC8C4\uB97C \uD5A5\uD574 \uB098\uC544\uAC14\uB2E4."
    Sound: {fileID: 8300000, guid: 02d2f54c38849c147b2003c2cf581905, type: 3}
