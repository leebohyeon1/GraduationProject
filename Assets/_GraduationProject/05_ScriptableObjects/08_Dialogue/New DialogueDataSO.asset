  m_Script: {fileID: 11500000, guid: 0619fb8750ed77c44a41a2e203ef5c61, type: 3}
  m_Name: New DialogueDataSO
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDataSO
  DialogueGroupID: 1
  DialogueType: 0
  NeedConditionList:
  - {fileID: 11400000, guid: b49e8f5967502564fb774defa1c68fb9, type: 2}
  DialogueList:
  - SpeakerName: 
    DialogueText: "\uD55C\uB54C \uC6A9\uC758 \uC2E0\uC73C\uB85C \uBD88\uB838\uB358
      \uC694\uB974\uBB38\uC740 \uAE4A\uC740 \uC7A0\uC5D0\uC11C \uAE68\uC5B4\uB098
      \uC57D\uD574\uC9C4 \uC721\uC2E0\uC744 \uC77C\uC73C\uCF1C \uC138\uC6B0\uBA70
      \uC815\uC2E0\uC744 \uCC28\uB838\uB2E4."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uACFC\uAC70\uC758 \uC601\uAD11\uACFC\uB294 \uB2EC\uB9AC, \uC694\uB974\uBB38\uC758
      \uC721\uC2E0\uC740 \uC5F0\uC57D\uD558\uACE0 \uC791\uC544\uC838 \uC788\uC5C8\uB2E4."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uD5C8\uB098 \uC694\uB974\uBB38 \uAE30\uC5B5\uD55C\uB2E4. \uC721\uC2E0\uC740
      \uD5C8\uC6B8\uC77C \uBFD0, \uC694\uB974\uBB38\uC758 \uC9C4\uC815\uD55C \uAC15\uD568\uC740
      \uACB0\uCF54 \uB9C8\uB974\uC9C0 \uC54A\uB294 \uC815\uC2E0\uC758 \uC2EC\uC5F0\uC5D0\uC11C
      \uC19F\uAD6C\uCE58\uB294 \uBC95\uC784\uC744."
    Sound: {fileID: 0}
  - SpeakerName: 
    DialogueText: "\uC694\uB974\uBB38\uC740 \uC57D\uD574\uC9C4 \uC721\uC2E0\uC744
      \uC5B5\uC9C0\uB85C \uC774\uB04C\uBA70, \uC2A4\uC2A4\uB85C \uC9CA\uC5B4\uC9C4
      \uACFC\uAC70\uC758 \uC18D\uC8C4\uB97C \uD5A5\uD574 \uB098\uC544\uAC14\uB2E4."
    Sound: {fileID: 0}
