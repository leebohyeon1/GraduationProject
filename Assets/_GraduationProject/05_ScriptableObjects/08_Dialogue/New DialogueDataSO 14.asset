%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0619fb8750ed77c44a41a2e203ef5c61, type: 3}
  m_Name: New DialogueDataSO 14
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDataSO
  DialogueGroupID: 13
  DialogueType: 1
  NeedConditionList: []
  DialogueList:
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uC88B\uC544! \uC544\uC8FC \uC88B\uC544! \uACC4\uC57D\uC744 \uBC1B\uC544\uB4E4\uC600\uC73C\uB2C8
      \uC88B\uC740 \uC815\uBCF4\uB97C \uC54C\uB824\uC8FC\uC9C0."
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uB124\uAC00 \uBC29\uAE08 \uC5BB\uC740 \uAC83\uC740 \uC694\uB974\uBB38
      \uB108\uC758 \uC5FC\uC6D0\uC758 \uC870\uAC01\uC774\uC57C. "
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uBAA8\uB178\uB9AC\uC2A4\uAC00 \uD30C\uAD34\uB420 \uB54C \uD30C\uD3B8\uD654\uB41C
      \uB108\uC758 \uD798\uC774\uB77C\uACE0 \uBCF4\uBA74 \uC774\uD574\uD558\uAE30
      \uC27D\uACA0\uC9C0."
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uADF8\uB990\uACE0 \uB124\uAC00 \uBC29\uAE08 \uB9CC\uB0AC\uC5C8\uB358
      \uB140\uC11D\uB4E4\uC740 \uC774 \uC5FC\uC6D0\uC758 \uC870\uAC01\uC744 \uBA39\uAE30
      \uC704\uD574 \uD658\uC7A5\uD55C \uC874\uC7AC\uB4E4\uC774\uC9C0."
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uC6B0\uB9AC\uB294 \uADF8 \uC874\uC7AC\uB97C '\uB098\uB974' \uB77C\uACE0
      \uBD80\uB978\uB2E4\uB124."
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uC544\uBB34\uD2BC \uC774\uACF3\uC5D0 \uB098\uB974\uB4E4\uC774
      \uC774\uB807\uAC8C \uBAB0\uB824\uB4E0 \uAC83\uB3C4 \uC544\uB9C8 \uB108\uC758
      \uC870\uAC01 \uB0C4\uC0C8\uB97C \uB9E1\uC558\uAE30 \uB54C\uBB38 \uC77C\uD14C\uC9C0. "
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uADF8\uB9AC\uACE0 \uCD5C\uADFC \uB098\uB974\uB4E4\uC774 \uADF8
      \uC5B4\uB5A4 \uAD6C\uC5ED\uBCF4\uB2E4 \uB9CE\uC774 \uBAB0\uB824\uB4E0 \uACF3\uC774
      \uC788\uC5B4. "
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uBC14\uB85C '\uC5EC\uC6B0\uAC00 \uC6B0\uB294 \uC232'\uC774\uC9C0."
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uADF8\uACF3\uC73C\uB85C \uAC00\uBA74 \uB108\uC758 \uC5FC\uC6D0\uC758
      \uC870\uAC01\uC744 \uB418\uCC3E\uC744 \uC218 \uC788\uC744 \uAC70\uC57C. \uADF8\uAC74
      \uB0B4\uAC00 \uC7A5\uB2F4\uD558\uC9C0."
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uC774 \uC8FC\uBCC0\uC5D0 \uC5D0\uAE30\uB974\uB97C \uBD80\uB97C
      \uC218 \uC788\uB294 \uD1A0\uD15C\uC774 \uC788\uB2E4\uB124. "
    Sound: {fileID: 0}
  - SpeakerName: "\uD06C\uB9AC\uADF8"
    DialogueText: "\uADF8 \uD1A0\uD15C\uC744 \uC774\uC6A9\uD558\uBA74 \uC5D0\uAE30\uB974\uAC00
      \uB098\uD0C0\uB0A0 \uD14C\uB2C8, \uADF8 \uB140\uC11D\uC744 \uD1B5\uD574 '\uC5EC\uC6B0\uAC00
      \uC6B0\uB294 \uC232'\uC73C\uB85C \uC774\uB3D9\uD558\uBA74 \uB420 \uAC70\uC57C."
    Sound: {fileID: 0}
