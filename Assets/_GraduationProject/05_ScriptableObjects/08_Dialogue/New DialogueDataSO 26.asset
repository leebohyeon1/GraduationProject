--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0619fb8750ed77c44a41a2e203ef5c61, type: 3}
  m_Name: New DialogueDataSO 26
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDataSO
  DialogueGroupID: 0
  DialogueType: 1
  NeedConditionList: []
  DialogueList:
  - SpeakerName: ???
    DialogueText: "\uC774 \uC791\uACE0 \uAC00\uB828\uD55C \uBD88\uC30D\uD55C \uB9AC\uD504\uC57C..."
    Sound: {fileID: 0}
  - SpeakerName: ???
    DialogueText: "\uC65C \uAD1C\uD788 \uC774 \uACF3\uC5D0 \uC640\uC11C \uB098\uB974\uB4E4\uC5D0\uAC8C
      \uACF5\uACA9\uBC1B\uACE0 \uC788\uB294 \uAC70\uB2C8?"
    Sound: {fileID: 0}
  - SpeakerName: ???
    DialogueText: "\uD558\uC9C0\uB9CC \uAC71\uC815\uD558\uC9C0 \uB9C8\uB834. "
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC774 \uC232\uC744 \uAD00\uB9AC\uD558\uB294 \uC601\uD63C \uAD00\uB9AC\uC790
      \uD504\uB808\uC774\uC57C\uAC00 \uC654\uC73C\uB2C8..\r\n"
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: ...
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC7A0\uAE50... \uB10C \uADF8\uB0E5 \uB9AC\uD504\uAC00 \uC544\uB2C8\uAD6C\uB098. "
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uB108\uC758 \uBAB8 \uC548\uC5D0 \uC7A0\uB4E4\uC5B4 \uC788\uB294
      \uADF8 \uC601\uD63C\uC740..."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uB108.. \uC694\uB974\uBB38 \uC774\uAD6C\uB098."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: ...
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC774\uBD10 \uC694\uB974\uBB38, \uB108\uC640 \uC2E0\uB9C8\uB77C\uC758
      \uD589\uB3D9\uC73C\uB85C \uC778\uD574 \uB0B4 \uC232\uC774 \uC774\uB807\uAC8C
      \uB354\uB7EC\uC6CC\uC84C\uB294\uB370...\n\uB108\uB294 \uBB34\uC2A8 \uC0DD\uAC01\uC73C\uB85C
      \uC774 \uACF3\uC5D0 \uC628 \uAC70\uC9C0? "
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC124\uB9C8... \uC774 \uC5FC\uC6D0\uC758 \uC870\uAC01\uC774\uB77C\uB3C4
      \uAC00\uC9C0\uB7EC \uC628 \uAC74\uAC00?"
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: " \uACE0\uC791 \uADF8\uB7F0 \uC774\uC720\uB85C \uBED4\uBED4\uD558\uAC8C
      \uC774 \uACF3\uC5D0 \uCC3E\uC544\uC628 \uAC74..."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: ...
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC774\uBD10 \uC694\uB974\uBB38, \uB098\uB791 \uACC4\uC57D \uD558\uC9C0
      \uC54A\uACA0\uC5B4?"
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uB124\uAC00 \uC815\uC2E0\uC744 \uC783\uC740 \uB3D9\uC548 \uB09C
      \uB108\uC758 \uC815\uCCB4\uB97C \uBAB0\uB790\uAE30 \uB54C\uBB38\uC5D0 \uB108\uB97C
      \uC800 \uB098\uB974\uB4E4\uB85C\uBD80\uD130 \uC9C0\uCF1C\uC8FC\uACE0 \uC788\uC5C8\uC5B4."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uADF8\uB9AC\uACE0 \uADF8 \uC77C\uB85C \uC778\uD574 \uB0B4 \uD798\uC774
      \uB108\uBB34\uB098\uB3C4 \uBE60\uC838\uBC84\uB838\uC9C0."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uADF8\uB7EC\uB2C8 \uB098\uB791 \uACC4\uC57D\uC744 \uD558\uC790."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC774 \uC5FC\uC6D0\uC758 \uC870\uAC01\uC744 \uC6D0\uD558\uC9C0?
      \uB3CC\uB824\uC904\uAC8C. "
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uB2E8 \uC774 \uC5FC\uC6D0\uC758 \uC870\uAC01\uC744 \uAC00\uC838\uAC00\uBA74
      \uB10C \uB098\uB97C \uB300\uC2E0\uD574\uC11C \uC774 \uC232\uC744 \uAC10\uC5FC\uC2DC\uD0A8
      \uB098\uB974\uB97C \uCC3E\uC544 \uC5C6\uC560\uC918\uC57C \uD574. "
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uC5B4\uB54C? \uADF8 \uC694\uB974\uBB38\uC774\uB77C\uBA74 \uADF8
      \uC5B4\uB5A4 \uAC15\uD55C \uB098\uB974\uB77C\uB3C4 \uCC98\uCE58\uD560 \uC218
      \uC788\uC796\uC544."
    Sound: {fileID: 0}
  - SpeakerName: "\uD504\uB808\uC774\uC57C"
    DialogueText: "\uBC1B\uC544\uB4E4\uC77C\uB798?"
    Sound: {fileID: 0}
