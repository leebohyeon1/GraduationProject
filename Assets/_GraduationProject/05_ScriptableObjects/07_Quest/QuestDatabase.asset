    - {fileID: 11400000, guid: 114ff1fa5be60ac4a9130793b2bfa9d5, type: 2}
    NextQuestID: 1005
    Title: "\uB098\uB974\uC758 \uD3EC\uC704\uB9DD"
    DescriptionSummary: "\uBAB0\uB824\uC624\uB294 \uBAA8\uB4E0 \uB098\uB974\uB4E4\uC744
      \uCC98\uCE58\uD558\uACE0 \uC0B4\uC544\uB0A8\uC73C\uC138\uC694."
    DescriptionDetail: "\uB098\uB974\uB4E4\uC774 \uC694\uB974\uBB38\uC744 \uD5A5\uD574
      \uD280\uC5B4 \uB098\uC654\uC2B5\uB2C8\uB2E4. \n\uC57D\uD574\uC9C4 \uADF8\uC758
      \uC721\uC2E0\uC740 \uC218\uB9CE\uC740 \uB098\uB974\uB4E4\uC744 \uCC98\uCE58\uD558\uAE30\uC5D0\uB294
      \uC5ED\uBD80\uC871\uC785\uB2C8\uB2E4.\n\uADF8\uB7FC\uC5D0\uB3C4 \uBD88\uAD6C\uD558\uACE0
      \uC694\uB974\uBB38\uC740 \uB098\uB974\uB4E4\uC744 \uC804\uBD80 \uCC98\uCE58\uD558\uC5EC
      \uC55E\uC73C\uB85C \uB098\uC544\uAC00\uC57C \uD569\uB2C8\uB2E4."
    GoalText: "\uBAB0\uB824\uC624\uB294 \uBAA8\uB4E0 \uB098\uB974\uB4E4\uC744 \uCC98\uCE58\uD558\uACE0
      \uC0B4\uC544\uB0A8\uC73C\uC138\uC694."
  - ID: 1005
    AcceptedConditionList:
    - {fileID: 11400000, guid: 1b400189971fbd143a4ff57bb8cf1b35, type: 2}
    ClearConditionList:
    - {fileID: 11400000, guid: f4927f55fd488744191483607bb8c6f1, type: 2}
    NextQuestID: 1006
    Title: "\uC6A9\uC758 \uD1A0\uD15C"
    DescriptionSummary: "\uC6A9\uC758 \uD1A0\uD15C \uC18D \uC7A0\uB4E4\uC5B4\uC788\uB294
      \uD798\uC744 \uC5BB\uC73C\uC138\uC694."
    DescriptionDetail: "\uB098\uB974\uB4E4\uC744 \uC804\uBD80 \uCC98\uCE58\uD55C
      \uC694\uB974\uBB38\uC758 \uB208 \uC55E\uC5D0 \uC6A9\uC758 \uD615\uC0C1\uC744
      \uB744\uB294 \uD1A0\uD15C\uC774 \uB098\uD0C0\uB0A9\uB2C8\uB2E4.\n\uD1A0\uD15C\uC758
      \uC548\uCABD\uC5D0 \uC790\uC2E0\uC758 \uD798\uC774 \uC2A4\uBA70\uB4E4\uC5B4
      \uC788\uB2E4\uB294 \uAC83\uC744 \uBCF8\uB2A5\uC801\uC73C\uB85C \uB290\uB080
      \uC694\uB974\uBB38\uC740 \uD1A0\uD15C\uC744 \uD30C\uAD34\uD558\uC5EC  \uD1A0\uD15C
      \uC548\uCABD\uC5D0 \uC2A4\uBA70\uB4E0 \uD798\uC744 \uD68D\uB4DD\uD558\uC5EC\uC57C
      \uD569\uB2C8\uB2E4. "
    GoalText: "\uC6A9\uC758 \uD1A0\uD15C \uC18D \uC7A0\uB4E4\uC5B4\uC788\uB294 \uD798\uC744
      \uC5BB\uC73C\uC138\uC694."
  - ID: 1006
    AcceptedConditionList:
    - {fileID: 11400000, guid: f4927f55fd488744191483607bb8c6f1, type: 2}
