    - {fileID: 11400000, guid: 46760ec3e43f573489b97d327396c5fb, type: 2}
    NextQuestID: 1002
    Title: "\uC18D\uC8C4\uC758 \uAE38"
    DescriptionSummary: "\uC791\uC544\uC9C4 \uBAB8\uC744 \uC774\uB04C\uACE0 \uC232\uC744
      \uD5A5\uD574 \uB098\uC544\uAC00\uC138\uC694."
    DescriptionDetail: "\uACFC\uAC70 \uCC2C\uB780\uD55C \uC601\uAD11\uC744 \uB204\uB838\uB358
      \uC6A9\uC758 \uC2E0, \uC694\uB974\uBB38. \n\uC774\uC81C\uB294 \uC1E0\uC57D\uD574\uC9C4
      \uC721\uC2E0\uB9CC\uC774 \uB0A8\uC558\uC73C\uB098,\uADF8\uB294 \uC790\uC2E0\uC758
      \uC8C4\uB97C \uC18D\uC8C4\uD558\uAE30 \uC704\uD574 \uBB34\uAC70\uC6B4 \uBAB8\uC744
      \uC774\uB04C\uACE0 \uB2E4\uC2DC \uAE38\uC744 \uB098\uC11C\uC57C \uD569\uB2C8\uB2E4."
    GoalText: "\uC791\uC544\uC9C4 \uBAB8\uC744 \uC774\uB04C\uACE0 \uC232\uC744 \uD5A5\uD574
      \uB098\uC544\uAC00\uC138\uC694."
  - ID: 1002
    AcceptedConditionList:
    - {fileID: 11400000, guid: 46760ec3e43f573489b97d327396c5fb, type: 2}
    ClearConditionList:
    - {fileID: 11400000, guid: 2574234933f227a41a8e6a2747ba09d3, type: 2}
    NextQuestID: 1003
    Title: "\uC6B4\uBA85\uC758 \uAC80"
    DescriptionSummary: "\uB208 \uC55E\uC5D0 \uB193\uC5EC\uC838 \uC788\uB294 \uB300\uAC80\uC744
      \uD68D\uB4DD\uD558\uC138\uC694."
    DescriptionDetail: "\uC694\uB974\uBB38\uC758 \uB208\uC55E\uC5D0 \uAC70\uB300\uD55C
      \uB300\uAC80\uC774 \uB193\uC5EC \uC788\uC2B5\uB2C8\uB2E4. \uC1E0\uC57D\uD574\uC9C4
      \uC9C0\uAE08\uC758 \uBAB8\uC73C\uB85C \uC774 \uC138\uACC4\uC5D0 \uC0B4\uC544\uB0A8\uAE30
      \uC704\uD574\uC11C\uB294, \uC774 \uC721\uC911\uD55C \uBB34\uAE30\uC758 \uD798\uC744
      \uBE4C\uB824\uC57C\uB9CC \uD569\uB2C8\uB2E4."
    GoalText: "\uB208 \uC55E\uC5D0 \uB193\uC5EC\uC838 \uC788\uB294 \uB300\uAC80\uC744
      \uD68D\uB4DD\uD558\uC138\uC694."
  - ID: 1003
    AcceptedConditionList:
    - {fileID: 11400000, guid: 2574234933f227a41a8e6a2747ba09d3, type: 2}
    ClearConditionList:
    - {fileID: 11400000, guid: 125e71e3fb025fe49ada709ae3fd68be, type: 2}
    NextQuestID: 1004
    Title: "\uACFC\uC624\uC758 \uC528\uC557"
    DescriptionSummary: "\uC232\uC758 \uC2EC\uCE35\uBD80\uB97C \uD5A5\uD574 \uB098\uC544\uAC00\uC138\uC694."
    DescriptionDetail: "\uB300\uAC80\uC744 \uC5BB\uC740 \uC694\uB974\uBB38\uC740
      \uC232\uC758 \uAE4A\uC740 \uACF3\uC744 \uD5A5\uD574 \uB098\uC544\uAC11\uB2C8\uB2E4.
      \uC232 \uC548\uCABD \uC5B4\uB450\uC6B4 \uAE30\uC6B4\uC744 \uB290\uB080 \uC694\uB974\uBB38\uC740
      \uADF8 \uAE30\uC6B4\uC758 \uC6D0\uC778\uC774 \uBB34\uC5C7\uC778\uC9C0 \uCC3E\uAE30
      \uC704\uD574 \uC232 \uAE4A\uC740 \uACF3\uC744 \uD5A5\uD574 \uB098\uC544\uAC11\uB2C8\uB2E4."
    GoalText: "\uC232\uC758 \uC2EC\uCE35\uBD80\uB97C \uD5A5\uD574 \uB098\uC544\uAC00\uC138\uC694."
  - ID: 1004
    AcceptedConditionList:
