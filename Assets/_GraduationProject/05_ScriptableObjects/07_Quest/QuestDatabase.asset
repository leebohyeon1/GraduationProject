      \uBD80\uD130 \uD0DC\uC5B4\uB09C \uC874\uC7AC '\uB098\uB974'\uB4E4\uC774 \uC232\uC744
      \uB354\uB7FD\uD788\uB294 \uCC38\uD639\uD55C \uAD11\uACBD\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC694\uB974\uBB38\uC740
      \uC790\uC2E0\uC758 \uACFC\uC624\uAC00 \uBE5A\uC5B4\uB0B8 \uC774\uB4E4\uC744
      \uD558\uB098\uD558\uB098 \uB2E4\uC2DC \uAC70\uB450\uC5B4\uB4E4\uC5EC\uC57C\uB9CC
      \uD569\uB2C8\uB2E4."
    GoalText: "\uC6A9\uC758 \uD1A0\uD15C\uC744 \uD68D\uB4DD\uD558\uC138\uC694. (
      0/3 )"
