    NextQuestID: 1020
    Title: "\uACFC\uC624\uC758 \uC528\uC557"
    DescriptionSummary: "\uC232\uC758 \uC2EC\uCE35\uBD80\uB97C \uD5A5\uD574 \uB098\uC544\uAC00\uC138\uC694."
    DescriptionDetail: "\uB300\uAC80\uC744 \uC5BB\uC740 \uC694\uB974\uBB38\uC740
      \uC232\uC758 \uAE4A\uC740 \uACF3\uC744 \uD5A5\uD574 \uB098\uC544\uAC11\uB2C8\uB2E4.
      \uC232 \uC548\uCABD \uC5B4\uB450\uC6B4 \uAE30\uC6B4\uC744 \uB290\uB080 \uC694\uB974\uBB38\uC740
      \uADF8 \uAE30\uC6B4\uC758 \uC6D0\uC778\uC774 \uBB34\uC5C7\uC778\uC9C0 \uCC3E\uAE30
      \uC704\uD574 \uC232 \uAE4A\uC740 \uACF3\uC744 \uD5A5\uD574 \uB098\uC544\uAC11\uB2C8\uB2E4."
    GoalText: "\uC232\uC758 \uC2EC\uCE35\uBD80\uB97C \uD5A5\uD574 \uB098\uC544\uAC00\uC138\uC694."
  - ID: 1019
    AcceptedConditionList:
    - {fileID: 11400000, guid: d597d8954132b654bb020dcb41924a13, type: 2}
    ClearConditionList:
    - {fileID: 11400000, guid: 1f41ca7c367df0340a7da07e6057bfa9, type: 2}
    NextQuestID: 1020
    Title: "\uACFC\uC624\uC758 \uC528\uC557"
    DescriptionSummary: "\uB300\uAC80\uC744 \uC774\uC6A9\uD558\uC5EC \uB098\uB974\uC758
      \uACF5\uACA9\uC744 \uC0C1\uC1C4\uD558\uC138\uC694."
    DescriptionDetail: "\uBB34\uAE30\uB97C \uC5BB\uC740 \uC694\uB974\uBB38\uC758
      \uC55E\uC744 \uAC00\uB85C\uB9C9\uC740 \uAC83\uC740, \uC790\uC2E0\uC758 \uACFC\uC624\uB85C
      \uBD80\uD130 \uD0DC\uC5B4\uB09C \uC874\uC7AC '\uB098\uB974'\uB4E4\uC774 \uC232\uC744
      \uB354\uB7FD\uD788\uB294 \uCC38\uD639\uD55C \uAD11\uACBD\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC694\uB974\uBB38\uC740
      \uC790\uC2E0\uC758 \uACFC\uC624\uAC00 \uBE5A\uC5B4\uB0B8 \uC774\uB4E4\uC744
      \uD558\uB098\uD558\uB098 \uB2E4\uC2DC \uAC70\uB450\uC5B4\uB4E4\uC5EC\uC57C\uB9CC
      \uD569\uB2C8\uB2E4."
    GoalText: "\uB300\uAC80\uC744 \uC774\uC6A9\uD558\uC5EC \uB098\uB974\uC758 \uACF5\uACA9\uC744
      \uC0C1\uC1C4\uD558\uC138\uC694."
