        {
            "m_Id": "31d1d19a19d944dcaa50a4b776f87e39"
        },
        {
            "m_Id": "197983cbb72a4c3e8b87a1926796ce14"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GetMainLight",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if defined(SHADERGRAPH_PREVIEW)\r\n    Direction = float3(0.5, 0.5, 0);\r\n    Color = 1;\r\n    ShadowAtten = 1;\r\n#else\r\n    #if defined(UNIVERSAL_LIGHTING_INCLUDED)\r\n        Light mainLight = GetMainLight();\r\n        Direction = mainLight.direction;\r\n        Color = mainLight.color;\r\n        ShadowAtten = mainLight.shadowAttenuation;\r\n    #else\r\n        Direction = float3(0.5, 0.5, 0);\r\n        Color = 1;\r\n        ShadowAtten = 1;\r\n    #endif\r\n#endif\n"
}

